# ==============================================================================
# Turso Database Configuration (LibSQL)
# ==============================================================================
# In local development, you can leave these blank or use "file:portfolio.db"
# For production (Vercel), create a Turso database and paste your credentials:
TURSO_DATABASE_URL=libsql://your-database-name-organization.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# ==============================================================================
# Cloudinary Media Configuration
# ==============================================================================
# Required for media asset upload signatures and asset management:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# Security & Admin Session Management
# ==============================================================================
# Cryptographically random string used for session entropy & verification
SESSION_SECRET=your_random_32_byte_secret_here

# Initial Admin Account Setup (used by: node scripts/create-admin.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password_min_8_chars
